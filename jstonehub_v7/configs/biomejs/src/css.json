{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "css": {
    "assist": { "enabled": true },
    "linter": { "enabled": true },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true,
      "allowWrongLineComments": false
    },
    "formatter": {
      "enabled": true,
      "quoteStyle": "double",
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80
    }
  }
}
