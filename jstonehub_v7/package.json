        "tailwind-merge": "3.5.0"
      },
      "backend": {
        "typebox": "1.1.23",
        "bullmq": "5.74.1",
        "ioredis": "5.10.1",
        "minio": "8.0.7"
      },
      "api": {
        "drizzle-orm": "0.45.2",
        "drizzle-typebox": "0.3.3",
        "drizzle-kit": "0.31.10",
        "@elysiajs/cron": "1.4.1",
        "@elysiajs/cors": "1.4.1",
        "elysia": "1.4.28",
        "jose": "6.2.2",
