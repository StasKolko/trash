{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "ignoreUnknown": false,
    "maxSize": 1048576,
    "includes": [
      "**",

      // IGNORE ROOT DIRS
      "!.qodo/**",
      "!.husky/**",

      // IGNORE DIRS
      "!**/.turbo/**",
      "!**/coverage/**",
      "!**/node_modules/**",

      // IGNORE ROOT FILES
      "!bun.lock"

      // IGNORE FILES
    ]
  }
}
